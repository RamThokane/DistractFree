# ── Server ──────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ─────────────────────────────────────────
# Required in production. Falls back to in-memory MongoDB in development.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?appName=DistractFree

# ── JWT ─────────────────────────────────────────────
# IMPORTANT: Use a strong random secret in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_IN_PRODUCTION
JWT_EXPIRES_IN=7d

# ── Google OAuth ────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ── Frontend / CORS ─────────────────────────────────
# The URL of the deployed frontend app (allowed by CORS)
# Production: https://distractfree.site
CLIENT_URL=http://localhost:3000
# More allowed origins, comma-separated (chrome-extension:// is always allowed;
# localhost only outside production)
# Production: https://distractfree.site,https://www.distractfree.site
ALLOWED_ORIGINS=

# ── ML ──────────────────────────────────────────────
# Which model answers predictions: logreg (logistic regression, default) or tree.
# logreg falls back to the tree when its model file is missing or invalid.
ML_MODEL=logreg
# Timezone assumed for sessions recorded before the client sent one.
ML_DEFAULT_TIMEZONE=Asia/Kolkata
# Retrain in the background after 25+ new real sessions (needs Python on the server).
ML_AUTO_RETRAIN=true
# Comma-separated emails allowed to call POST /api/ml/retrain.
# Unset: anyone signed in (development) / nobody (production).
ML_ADMIN_EMAILS=
