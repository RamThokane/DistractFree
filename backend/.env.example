# ── Server ──────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ─────────────────────────────────────────
# Required in production. Falls back to in-memory MongoDB in development.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?appName=DistractFree

# ── JWT ─────────────────────────────────────────────
# IMPORTANT: Use a strong random secret in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_IN_PRODUCTION
JWT_EXPIRES_IN=7d

# ── Google OAuth ────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ── Frontend ────────────────────────────────────────
# The URL of the deployed frontend app (used for CORS)
CLIENT_URL=http://localhost:3000

# ── ML Model (optional) ────────────────────────────
# URL of the Python Flask ML service (if deployed separately).
# Leave blank to use the built-in JavaScript decision tree model.
ML_SERVICE_URL=

# ── ML Model Path (local JS model) ────────────────
ML_MODEL_PATH=./ml/model/decision_tree_model.json
